# PyCharm
#  JetBrains specific template is maintained in a separate JetBrains.gitignore that can
#  be found at https://github.com/github/gitignore/blob/main/Global/JetBrains.gitignore
#  and can be added to the global gitignore or merged into this file.  For a more nuclear
#  option (not recommended) you can uncomment the following to ignore the entire idea folder.
#.idea/

# --- exa-star project-specific ---
# Large fMRI corpus: mounted on Kaggle via a Kaggle Dataset, never committed to git.
datasets/hcp/complete/
*.npz
# Keep only the small atlas COORDINATES file the code needs; drop the large NIfTI atlases.
datasets/hcp/atlases/*.nii
datasets/hcp/atlases/*.nii.gz
datasets/hcp/atlases/*.dlabel.nii
# Run artifacts / outputs.
output.csv
genome_1.csv
test_genomes/*.pkl
test_genomes/*.gv
test_genomes/*.png
test_genomes/*.npy

# evaluation chart outputs
eval_out/
norm_stats.npz
length_index.json
subject_split.json

# Trained model + seed pickles (regenerated by the pipeline; too large / not source)
*.pkl

# HCP subject-level metadata CSVs -- governed by the HCP Data Use Terms, not redistributable.
# Obtain them yourself; the code reads them at runtime. (The small atlas .dat file above is kept.)
datasets/hcp/HCP_YA_subjects_*.csv
